# Ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=enterprise_docs

# Graph thresholds
MAX_GENERATION_ATTEMPTS=3
TOXICITY_THRESHOLD=0.5
TOXICITY_HARD_BLOCK_THRESHOLD=0.8
GROUNDING_SIMILARITY_THRESHOLD=0.75
GROUNDING_FAILURE_RATIO=0.30
HITL_CONFIDENCE_THRESHOLD=0.5
INJECTION_SCORE_THRESHOLD=0.7
SCOPE_SIMILARITY_THRESHOLD=0.35

# Paths
HITL_QUEUE_DIR=./data/hitl_queue
AUDIT_LOG_DIR=./data/audit_logs
DOCS_DIR=./docs/sample_documents

# LLM timeout (seconds)
LLM_TIMEOUT=10
